diff --git a/ports/esp32/main.c b/ports/esp32/main.c
index 697f4ef..8cd6970 100644
--- a/ports/esp32/main.c
+++ b/ports/esp32/main.c
@@ -184,6 +184,18 @@ soft_reset:
 
 soft_reset_exit:
 
+    #ifdef MICROPY_HW_HAS_LVGL
+    // LVGL keeps state in C statics outside its (GC heap) global struct (default theme, ...), so a soft reset
+    // cannot restart it cleanly: display_create() then allocates garbage sizes. When the UI has been running,
+    // a soft reset (Ctrl-D, machine.soft_reset) is therefore turned into a full chip restart.
+    {
+        extern bool lv_is_initialized(void);
+        if (lv_is_initialized()) {
+            esp_restart();
+        }
+    }
+    #endif
+
     #if MICROPY_BLUETOOTH_NIMBLE
     mp_bluetooth_deinit();
     #endif
