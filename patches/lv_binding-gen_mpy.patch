+/* lv.set_error_hook(fn): fn(callback_name, exception) is called whenever a Python callback raised
+   (the exception itself is swallowed after printing so LVGL's C state stays consistent). */
+static mp_obj_t lvgl_mod_set_error_hook(mp_obj_t fn) {
+    MP_STATE_VM(mp_lv_error_hook) = (fn == mp_const_none) ? MP_OBJ_NULL : fn;
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(lvgl_mod_set_error_hook_obj, lvgl_mod_set_error_hook);
+
 void mp_lv_log_cb(lv_log_level_t level, const char * buf){
 
     mp_printf(&mp_plat_print, buf);
@@ -1832,7 +1841,7 @@ static unsigned long long mp_obj_get_ull(mp_obj_t obj)
 
     unsigned long long val = 0;
     bool big_endian = !(__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__);
-    mp_obj_int_to_bytes_impl(obj, big_endian, sizeof(val), (byte*)&val);
+    mp_obj_int_to_bytes(obj, sizeof(val), (byte*)&val, big_endian, true, false);
     return val;
 }
 
@@ -2929,9 +2938,33 @@ GENMPY_UNUSED static {return_type} {func_name}_callback({func_args})
     {build_args}
