-    {return_value_assignment}mp_call_function_n_kw(mp_obj_dict_get(callbacks, MP_OBJ_NEW_QSTR(MP_QSTR_{func_name})) , {num_args}, 0, mp_args);
-    _nesting--;
-    return{return_value};
+    /* Never let a Python exception unwind through LVGL's C code: it would leave lv_timer_handler's
+       "already_running" flag set and freeze the UI for good. Print the exception and carry on. */
+    nlr_buf_t nlr;
+    if (nlr_push(&nlr) == 0) {{
+        {return_value_assignment}mp_call_function_n_kw(mp_obj_dict_get(callbacks, MP_OBJ_NEW_QSTR(MP_QSTR_{func_name})) , {num_args}, 0, mp_args);
+        {return_value_local}
+        nlr_pop();
+        _nesting--;
+        return{return_value_ret};
+    }} else {{
+        _nesting--;
+        mp_obj_t exc = MP_OBJ_FROM_PTR(nlr.ret_val);
+        if (mp_obj_is_subclass_fast(MP_OBJ_FROM_PTR(mp_obj_get_type(exc)), MP_OBJ_FROM_PTR(&mp_type_KeyboardInterrupt))
+            || mp_obj_is_subclass_fast(MP_OBJ_FROM_PTR(mp_obj_get_type(exc)), MP_OBJ_FROM_PTR(&mp_type_SystemExit))) {{
+            nlr_jump(nlr.ret_val);      /* Ctrl-C from the REPL / sys.exit must still stop the program */
+        }}
+        mp_printf(&mp_plat_print, "Exception in {func_name} callback:\\n");
+        mp_obj_print_exception(&mp_plat_print, exc);
+        if (MP_STATE_VM(mp_lv_error_hook) != MP_OBJ_NULL) {{
+            nlr_buf_t nlr2;
+            if (nlr_push(&nlr2) == 0) {{
+                mp_call_function_2(MP_STATE_VM(mp_lv_error_hook), mp_obj_new_str("{func_name}", strlen("{func_name}")), exc);
+                nlr_pop();
+            }}
+        }}
+        {return_zero}
+    }}
 }}
 """.format(
